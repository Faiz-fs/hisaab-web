{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hisaab-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-26",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/hisaab-release.apk",
      "/downloads/hisaab-release.apk",
    ],
  },
  "r2_buckets": [
    {
      "binding": "HISAAB_RELEASES",
      "bucket_name": "hisaab-releases",
    },
  ],
  "compatibility_flags": ["nodejs_compat"],
}
